# ── Spring Tech KB — 本地开发环境变量模板 ─────────────────────────────────────
# 复制为 .env 并按需修改，.env 已加入 .gitignore。
# cp infra/.env.example infra/.env

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_DB=springkb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── TEI（Text Embeddings Inference） ───────────────────────────────────────────
TEI_PORT=8081
# BGE-M3（1024 维，支持 MRL 截断）是默认模型；换模型后需同步修改 application.yml 的 dimensions
EMBEDDING_MODEL=BAAI/bge-m3
# 私有模型或需要登录时设置此 token
HUGGING_FACE_HUB_TOKEN=

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Reranker（profile: rerank，按需启用） ───────────────────────────────────────
RERANKER_PORT=8082
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 应用侧开关（需同时启动 tei-reranker 服务）：
# RERANKER_ENABLED=true
# RERANKER_BASE_URL=http://localhost:8082

# ── 可观测性（profile: obs） ────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# ── 应用侧环境变量（Spring Boot 启动时设置，不归 docker compose 管） ────────────
# DB_URL=jdbc:postgresql://localhost:5432/springkb
# DB_USER=postgres
# DB_PASSWORD=postgres
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL_LITE=claude-3-5-haiku-latest
# LLM_MODEL_STANDARD=claude-sonnet-4-5
# LLM_MODEL_EXPERT=claude-opus-4-5
# LLM_DAILY_TOKEN_LIMIT=100000
# PROMPT_REGISTRY_ADMIN_TOKEN=<generate-a-long-random-secret>
# API_RATE_LIMIT_PER_MINUTE=60
# API_RATE_LIMIT_KEY_PREFIX=springkb:gateway:requests
# SPRINGTECHKB_RUNTIME_ROLE=all   # all | ai-engine | kb-indexer
# JWT_SECRET=<base64-encoded-at-least-32-random-bytes>
# JWT_ISSUER=spring-tech-kb
# JWT_ACCESS_TOKEN_TTL=15m
# TEI_BASE_URL=http://localhost:8081
# OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SAMPLING_PROBABILITY=1.0

# Phase 2 structured generation (one shared deadline across 1-3 attempts).
# STRUCTURED_GENERATION_DEADLINE=90s
# STRUCTURED_GENERATION_MAX_ATTEMPTS=3

# Optional Langfuse v3.22+/v4 OTLP export, disabled by default.
# Run your self-hosted instance on a port other than frontend/Grafana 3000.
# LANGFUSE_ENABLED=false
# LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=<your-project-public-key>
# LANGFUSE_SECRET_KEY=<your-project-secret-key>
# HTTPS is required except loopback. Prompt/question/answer contents are not exported.

# Set all three USD-per-million prices for each tier you use.
# With no complete price set, cost remains NULL (unknown), not a misleading zero.
# Obtain current prices for your configured model; no vendor price is assumed.
# LLM_PRICE_STANDARD_INPUT_PER_MILLION=
# LLM_PRICE_STANDARD_OUTPUT_PER_MILLION=
# LLM_PRICE_STANDARD_CACHE_READ_PER_MILLION=
# Repeat STANDARD -> LITE / EXPERT for the remaining tiers.
